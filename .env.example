NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave OPENAI_API_KEY blank to use free local-template generation.
# Adding a key enables model-powered output and may incur provider costs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Supabase groundwork. Not required to run the local-first app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keep true for local browser-storage demo mode. This is not multi-user production auth.
NEXT_PUBLIC_DEMO_MODE=true
